# Caddy: replace the host, point root at site/.
example.com {
    root * /srv/portfolio/site
    encode zstd gzip
    @hashed path_regexp \.[0-9a-f]{10}\.(js|wasm)$
    header @hashed Cache-Control "public, max-age=31536000, immutable"
    header /toy/odin.js Cache-Control "public, max-age=86400"
    header /assets.json Cache-Control "no-cache"
    header /index.html Cache-Control "no-cache"
    header / Cache-Control "no-cache"
    file_server
}
